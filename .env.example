# JointGuard Environment Configuration (Prototype Phase 1)
PROJECT_NAME="JointGuard Prototype"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL="sqlite:///./jointguard.db"

# Simulation Settings
SIMULATION_INTERVAL_SECONDS=2.0
SIMULATION_AUTO_START=True

# Centralized Scoring Defaults (Configurable)
VIBRATION_BASELINE=0.5
TEMP_WARNING_THRESH=45.0
TEMP_CRITICAL_THRESH=60.0

# Disclaimers
SCORING_METHOD="RULE_BASED_WEIGHTED_FUSION"
HALL_SENSOR_TYPE="A3144_DEMO_MAGNETIC_EVENT"
